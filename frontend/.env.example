# Frontend (Expo) environment variables.
# Copy to `.env` and fill in. Expo inlines EXPO_PUBLIC_* vars at build time.
# On a physical device, use your machine's LAN IP for the API URL (not localhost).

# Python worker API — all data/compute (logs, recommendations, similar, taste-profile, dishes).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth — owns sessions/tokens. Find these in the Supabase dashboard (Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
